# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# development | test | staging | production
SNEHA_ENVIRONMENT=development
SNEHA_DEBUG=false

# Development: local SQLite file. Staging/production: PostgreSQL is REQUIRED.
SNEHA_DATABASE_URL=sqlite:///./sneha_dev.db
# SNEHA_DATABASE_URL=postgresql://sneha:CHANGE_ME@localhost:5432/sneha

# Comma-separated origins allowed to call the API from a browser (the web dashboard).
SNEHA_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required (>= 32 chars) outside development/test. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SNEHA_SECRET_KEY=

# Conversation understanding: deterministic (default, offline-safe) or gemini (optional).
SNEHA_CONVERSATION_PROVIDER=deterministic
# SNEHA_GEMINI_API_KEY=
# SNEHA_GEMINI_MODEL=gemini-3.6-flash

# Account emails (verification, password reset). In development, "log" prints the emails,
# including their links, to the API log. Production needs "smtp" (or "disabled").
SNEHA_EMAIL_BACKEND=log
SNEHA_DASHBOARD_URL=http://localhost:5173
SNEHA_REQUIRE_EMAIL_VERIFICATION=false
# SNEHA_EMAIL_FROM=SNEHA <no-reply@example.org>
# SNEHA_SMTP_HOST=smtp-relay.brevo.com
# SNEHA_SMTP_PORT=587
# SNEHA_SMTP_SECURITY=starttls
# SNEHA_SMTP_USERNAME=
# SNEHA_SMTP_PASSWORD=
# Or, where outgoing SMTP is blocked: SNEHA_EMAIL_BACKEND=brevo_api and
# SNEHA_BREVO_API_KEY=
